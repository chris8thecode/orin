{
  "name": "orin",
  "version": "1.0.0",
  "description": "Orin is a WhatsApp bot built with Baileys that provides enganging commands, admin controls and a web dashboard for management.",
  "main": "src/index.js",
  "scripts": {
    "start": "bun --env-file=.env src/index.js",
    "generate-secret": "bun src/scripts/generate-secret.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update": "bun x npm-check-updates -u"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "dashboard",
    "sqlite",
    "pino",
    "websocket",
    "automation"
  ],
  "author": "chris8thecode",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "pino-pretty": "^13.1.3"
  }
}
